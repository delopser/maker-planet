{
  "name": "makerplanet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "if exist _site rmdir /s /q _site",
    "build:html": "eleventy",
    "watch:html": "eleventy --watch",
    "dev": "eleventy && (vite _site & eleventy --watch)",
    "build": "eleventy && vite build _site --outDir ../dist",
    "preview": "vite preview _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "sass": "^1.83.1",
    "vite": "^5.4.9"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^6.0.4"
  }
}
